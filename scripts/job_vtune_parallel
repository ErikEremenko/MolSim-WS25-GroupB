#!/bin/bash
#SBATCH -J MolSim_VTune_Parallel
#SBATCH --clusters=cm4
#SBATCH --partition=cm4_tiny
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=112
#SBATCH --time=00:30:00
#SBATCH -o ./%x.%j.%N.out
#SBATCH -e ./%x.%j.%N.err
#SBATCH --get-user-env
#SBATCH --export=NONE

# Load modules
module load slurm_setup
module load cmake/3.30.0 ninja/1.12.1 gcc/14.2.0
module load intel-oneapi-vtune/2024.2.1

cd "$SLURM_SUBMIT_DIR/build" || exit 1

# Set OpenMP thread count
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OMP_PROC_BIND=close
export OMP_PLACES=cores

echo "=========================================="
echo "Running VTune analysis on: $(hostname)"
echo "CPUs per task: ${SLURM_CPUS_PER_TASK}"
echo "OMP_NUM_THREADS: ${OMP_NUM_THREADS}"
echo "=========================================="

# Run VTune Hotspots analysis for parallel execution
vtune -collect hotspots \
      -knob sampling-mode=hw \
      -result-dir "output/vtune_parallel_${SLURM_JOB_ID}" \
      ./MolSim ../input/profiling.yaml benchmark info linked

echo "=========================================="
echo "VTune analysis complete"
echo "=========================================="
