sbatch <<'EOF'
#!/bin/bash
#SBATCH -J MolSim_VTune
#SBATCH --clusters=serial
#SBATCH --partition=serial_std
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:20:00
#SBATCH -o ./%x.%j.%N.out
#SBATCH -e ./%x.%j.%N.err
#SBATCH --get-user-env
#SBATCH --export=NONE

module load slurm_setup
module load cmake/3.30.0 ninja/1.12.1 gcc/14.2.0
module load intel-oneapi-vtune/2024.2.1

cd "$SLURM_SUBMIT_DIR/build" || exit 1
export OMP_NUM_THREADS=1

# Run VTune Hotspots analysis
# Results saved to output/vtune_hotspots_<JOB_ID>
vtune -collect hotspots -result-dir "output/vtune_hotspots_${SLURM_JOB_ID}" ./MolSim ../input/profiling.yaml benchmark info linked
EOF
